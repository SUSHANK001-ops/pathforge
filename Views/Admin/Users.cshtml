@{
    ViewData["Title"] = "User Management";
}

<div class="pf-page py-12">
    <div class="flex justify-between items-end mb-8 border-b-[3px] border-[var(--dark)] pb-4">
        <div>
            <span class="pf-label mb-2">DIRECTORY & ROLES</span>
            <h1 class="pf-section-header">User Management</h1>
        </div>
    </div>

    <div class="pf-table-wrap">
        <table class="pf-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>System Administrator</td>
                    <td>admin@pathforge.local</td>
                    <td><span class="pf-status pf-status--live">Admin</span></td>
                    <td>Active</td>
                    <td>Sept 2026</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
