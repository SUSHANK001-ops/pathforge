@model IEnumerable<PathForge.Models.Entities.User>
@{
    ViewData["Title"] = "All Users";
    Layout = "_Layout";
}

<div class="pf-page" style="padding-top:3rem; padding-bottom:3rem;">

  <div style="display:flex; justify-content:space-between; align-items:flex-start;
              border-bottom:var(--border-outer); padding-bottom:1.5rem; margin-bottom:2rem;">
    <div>
      <span class="pf-label">User Management</span>
      <h1 class="pf-section-header" style="margin-top:0.4rem;">All Users</h1>
    </div>
    <a asp-action="Index" class="pf-btn pf-btn--ghost pf-btn--sm">← Dashboard</a>
  </div>

  @if (TempData["Success"] != null)
  {
    <div class="pf-alert pf-alert--success" style="margin-bottom:1.5rem;">@TempData["Success"]</div>
  }

  <div class="pf-table-wrap">
    <table class="pf-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var user in Model)
        {
          <tr>
            <td>@user.FullName</td>
            <td>@user.Email</td>
            <td><span class="pf-label" style="font-size:0.55rem;">@user.Role</span></td>
            <td>
              <span class="pf-status @(user.IsActive ? "pf-status--live" : "pf-status--draft")">
                @(user.IsActive ? "Active" : "Suspended")
              </span>
            </td>
            <td>
              <form asp-action="SuspendUser" asp-route-id="@user.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="pf-btn pf-btn--sm pf-btn--ghost">
                  @(user.IsActive ? "Suspend" : "Reactivate")
                </button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
