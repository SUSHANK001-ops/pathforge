@model PathForge.Models.Entities.Quiz
@{
    ViewData["Title"] = "Edit Questions — " + Model.Title;
    Layout = "_Layout";
}

<div class="pf-page" style="padding-top:3rem; padding-bottom:3rem;">

  <div style="border-bottom:var(--border-outer); padding-bottom:1.5rem; margin-bottom:2rem;">
    <span class="pf-label">Quiz Builder · @Model.Course.Title</span>
    <h1 class="pf-section-header" style="margin-top:0.4rem;">@Model.Title</h1>
    <p class="pf-body-cell" style="opacity:0.65; margin-top:0.35rem;">
      @Model.TimeLimitMinutes min &nbsp;·&nbsp; Pass mark @Model.PassMarkPercent%
    </p>
    <div style="margin-top:1rem;">
      <a asp-controller="Course" asp-action="EditModules" asp-route-id="@Model.CourseId"
         class="pf-btn pf-btn--ghost pf-btn--sm">← Back to Course Editor</a>
    </div>
  </div>

  <div style="display:grid; grid-template-columns:1fr 400px; gap:3rem; align-items:start;">

    @* Existing questions *@
    <div>
      <h2 class="pf-card-title" style="margin-bottom:1.25rem;">
        Questions (@Model.Questions.Count())
      </h2>

      @if (!Model.Questions.Any())
      {
        <div class="pf-alert">No questions yet. Add one using the form.</div>
      }

      @{ int n = 0; }
      @foreach (var q in Model.Questions)
      {
        n++;
        <div class="pf-card pf-card--outlined" style="margin-bottom:1rem;">
          <p class="pf-body" style="font-weight:700;">@n. @q.QuestionText
            <span class="pf-label" style="display:inline; font-size:0.55rem;">
              @q.Marks mark@(q.Marks != 1 ? "s" : "")
            </span>
          </p>
          <ul style="list-style:none; margin-top:0.5rem;">
            @foreach (var o in q.Options)
            {
              <li class="pf-body-cell" style="padding:0.2rem 0;
                  @(o.IsCorrect ? "color:var(--red); font-weight:700;" : "opacity:0.75;")">
                @(o.IsCorrect ? "✓ " : "○ ")@o.OptionText
              </li>
            }
          </ul>
        </div>
      }
    </div>

    @* Add question form *@
    <div style="position:sticky; top:80px;">
      <h2 class="pf-card-title" style="margin-bottom:1.25rem;">Add Question</h2>
      <div class="pf-card pf-card--outlined">
        <form asp-action="AddQuestion" method="post">
          @Html.AntiForgeryToken()
          <input type="hidden" name="quizId" value="@Model.Id" />

          <div class="pf-form-group">
            <label class="pf-form-label">Question Text</label>
            <textarea name="questionText" class="pf-input pf-textarea"
                      style="min-height:70px;" required></textarea>
          </div>

          <div class="pf-form-group">
            <label class="pf-form-label">Marks</label>
            <input type="number" name="marks" class="pf-input" value="1" min="1" required />
          </div>

          <label class="pf-form-label">Options (select the correct one)</label>
          @for (int i = 0; i < 4; i++)
          {
            <div class="pf-form-group" style="display:flex; align-items:center; gap:0.5rem;">
              <input type="radio" name="correctIndex" value="@i" @(i == 0 ? "checked" : "")
                     style="accent-color:var(--red);" required />
              <input type="text" name="optionTexts" class="pf-input"
                     placeholder="Option @(i + 1)" @(i < 2 ? "required" : "") />
            </div>
          }

          <button type="submit" class="pf-btn" style="width:100%;">Add Question</button>
        </form>
      </div>
    </div>

  </div>
</div>
