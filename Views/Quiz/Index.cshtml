@{
    ViewData["Title"] = "Quizzes";
}

<div class="pf-page py-12">
    <div class="flex justify-between items-end mb-8 border-b-[3px] border-[var(--dark)] pb-4">
        <div>
            <span class="pf-label mb-2">ASSESSMENT ENGINE</span>
            <h1 class="pf-section-header">Knowledge Quizzes</h1>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="pf-card--outlined">
            <span class="pf-label">MODULE 1 CHECKPOINT</span>
            <h3 class="pf-card-title my-2">C# & MVC Fundamentals</h3>
            <p class="pf-body-cell mb-4">10 questions &middot; 30 minutes time limit &middot; 50% pass mark</p>
            <a href="/Quiz/Take/1" class="pf-btn pf-btn--sm">Start Assessment</a>
        </div>
    </div>
</div>
