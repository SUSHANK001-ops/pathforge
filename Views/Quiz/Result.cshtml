@{
    ViewData["Title"] = "Quiz Results";
}

<div class="pf-page py-12">
    <div class="pf-card--outlined mb-8">
        <span class="pf-label">ASSESSMENT OUTCOME</span>
        <h1 class="pf-hero-title mb-2">Results & Feedback</h1>
        <div class="flex items-center gap-6 my-6">
            <div>
                <span class="pf-stat-cell__number">85%</span>
                <span class="pf-stat-cell__label">Final Score</span>
            </div>
            <div>
                <span class="pf-status pf-status--live text-sm px-3 py-1">PASSED</span>
            </div>
        </div>
        <p class="pf-body mb-6">You demonstrated proficiency in ASP.NET Core Middleware and Lifecycle management.</p>
        <a href="/Course" class="pf-btn">Continue Learning</a>
    </div>
</div>
