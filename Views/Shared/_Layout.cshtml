<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — PathForge</title>
  <!-- Preload the two most visible fonts so they're ready before first paint -->
  <link rel="preload" href="/fonts/shrikhand-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/space-grotesk-600.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>

  @* Render the shared navbar partial *@
  @await Html.PartialAsync("_Navbar")

  <main class="pf-main">
    @RenderBody()
  </main>

  @* Render the shared footer partial *@
  @await Html.PartialAsync("_Footer")

  @* Red progress strip at the bottom — the FRAME.md chrome *@
  <div class="pf-progress-strip" id="readProgress" style="width:0%"></div>

  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
