@model PathForge.Models.Entities.Certificate
@{
    ViewData["Title"] = "Certificate — " + Model.Course.Title;
    Layout = "_Layout";
}

<div class="pf-page" style="padding-top:2rem; padding-bottom:3rem;">

  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;"
       class="pf-noprint">
    <a asp-action="Index" class="pf-btn pf-btn--ghost pf-btn--sm">← My Certificates</a>
    <button type="button" class="pf-btn" onclick="window.print()">Print / Save PDF</button>
  </div>

  @* The certificate itself *@
  <div class="pf-cert">
    <div class="pf-cert__frame">
      <div class="pf-cert__brand"><span>PF</span> PathForge</div>
      <span class="pf-label" style="letter-spacing:4px;">Certificate of Completion</span>

      <p class="pf-cert__intro">This certifies that</p>
      <h1 class="pf-cert__name">@Model.Student.FullName</h1>
      <p class="pf-cert__intro">has successfully completed the course</p>
      <h2 class="pf-cert__course">@Model.Course.Title</h2>

      <div class="pf-cert__meta">
        <div>
          <span class="pf-label">Issued</span>
          <span class="pf-cert__metaval">@Model.IssuedAt.ToString("dd MMMM yyyy")</span>
        </div>
        <div>
          <span class="pf-label">Educator</span>
          <span class="pf-cert__metaval">@Model.Course.Educator.FullName</span>
        </div>
        <div>
          <span class="pf-label">Serial</span>
          <span class="pf-cert__metaval">@Model.SerialCode</span>
        </div>
      </div>
    </div>
  </div>
</div>

@section Styles {
<style>
  .pf-cert { max-width: 820px; margin: 0 auto; }
  .pf-cert__frame {
    border: 6px solid var(--dark); border-left: 10px solid var(--red);
    background: var(--bg); padding: 3.5rem 3rem; text-align: center;
  }
  .pf-cert__brand {
    font-family: var(--font-display); font-size: 1.6rem; color: var(--dark); margin-bottom: 1.5rem;
  }
  .pf-cert__brand span { color: var(--red); }
  .pf-cert__intro {
    font-family: var(--font-body); font-style: italic; opacity: 0.7; margin: 1.5rem 0 0.5rem;
  }
  .pf-cert__name {
    font-family: var(--font-display); font-size: clamp(2rem, 6vw, 3.5rem);
    color: var(--red); line-height: 1; transform: rotate(-2deg); margin: 0.5rem 0;
  }
  .pf-cert__course {
    font-family: var(--font-display); font-size: clamp(1.4rem, 4vw, 2.2rem);
    color: var(--dark); line-height: 1.1; margin-top: 0.4rem;
  }
  .pf-cert__meta {
    display: flex; justify-content: space-around; flex-wrap: wrap; gap: 1.5rem;
    border-top: var(--border-inner); margin-top: 2.5rem; padding-top: 1.5rem;
  }
  .pf-cert__metaval {
    display: block; font-family: var(--font-body); font-size: 0.9rem; margin-top: 0.25rem;
  }
  @@media print {
    .pf-navbar, .pf-footer, .pf-progress-strip, .pf-noprint { display: none !important; }
    .pf-page { padding: 0 !important; }
    body { background: #fff; }
  }
</style>
}
