@model PathForge.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="pf-page flex justify-center py-12">
    <div class="pf-form-panel">
        <div class="pf-form-panel__header">
            <span class="pf-label">AUTHENTICATION</span>
            <h2 class="pf-section-header">Sign In</h2>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="pf-alert pf-alert--error mb-4"></div>

            <div class="pf-form-group">
                <label asp-for="Email" class="pf-form-label">Email Address</label>
                <input asp-for="Email" class="pf-input" placeholder="user@domain.com" />
                <span asp-validation-for="Email" class="pf-field-error"></span>
            </div>

            <div class="pf-form-group">
                <label asp-for="Password" class="pf-form-label">Password</label>
                <input asp-for="Password" class="pf-input" placeholder="••••••••" />
                <span asp-validation-for="Password" class="pf-field-error"></span>
            </div>

            <div class="pf-form-group flex items-center gap-2">
                <input asp-for="RememberMe" class="accent-[var(--red)]" />
                <label asp-for="RememberMe" class="pf-bullet-body">Remember this session</label>
            </div>

            <button type="submit" class="pf-btn w-full text-center">Enter Platform</button>

            <div class="mt-6 pt-4 border-t-[1.5px] border-[var(--dark)] text-center">
                <span class="pf-bullet-body">Need an account?</span>
                <a href="/Auth/Register" class="pf-label inline-block ml-2 text-[var(--red)]">Register Here</a>
            </div>
        </form>
    </div>
</div>
