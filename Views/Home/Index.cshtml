@{
    ViewData["Title"] = "Home — Learning Constellations";
}

<div class="pf-page">
    <!-- Hero Section -->
    <header class="py-12 border-b-[3px] border-[var(--dark)]">
        <span class="pf-label mb-3">PATHFORGE &middot; LEARNING ARCHITECTURE &middot; PHASE 1</span>
        <h1 class="pf-hero-title mb-4">
            FORGE KNOWLEDGE INTO
            <span class="pf-hero-title-red">CONSTELLATIONS</span>
        </h1>
        <p class="pf-body text-lg mb-8">
            An editorial learning platform engineered for mastery. Explore structured learning paths, interactive modules, assessments, and real-time collaboration within an uncompromising bold poster design system.
        </p>
        <div class="flex flex-wrap gap-4 items-center">
            <a href="/Course" class="pf-btn">Explore Courses</a>
            <a href="/Auth/Register" class="pf-btn pf-btn--ghost">Get Started</a>
        </div>
    </header>

    <!-- Metrics Stat Grid -->
    <section class="my-12">
        <span class="pf-label mb-2">SYSTEM ARCHITECTURE METRICS</span>
        <div class="pf-stat-grid">
            <div class="pf-stat-cell">
                <span class="pf-stat-cell__number">14</span>
                <span class="pf-stat-cell__label">Database Entities</span>
            </div>
            <div class="pf-stat-cell">
                <span class="pf-stat-cell__number">10</span>
                <span class="pf-stat-cell__label">.NET 10 Framework</span>
            </div>
            <div class="pf-stat-cell">
                <span class="pf-stat-cell__number">v4</span>
                <span class="pf-stat-cell__label">Tailwind CSS Engine</span>
            </div>
            <div class="pf-stat-cell">
                <span class="pf-stat-cell__number">100%</span>
                <span class="pf-stat-cell__label">Square-Corner Poster Style</span>
            </div>
        </div>
    </section>

    <!-- Featured Courses / Learning Paths Section -->
    <section class="my-12">
        <div class="flex justify-between items-baseline mb-6 border-b-[1.5px] border-[var(--dark)] pb-2">
            <div>
                <span class="pf-label">CURATED CURRICULUM</span>
                <h2 class="pf-section-header">Featured Constellations</h2>
            </div>
            <a href="/Course" class="pf-label text-[var(--red)] hover:underline">View All &rarr;</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Course Card 1 -->
            <div class="pf-course-card">
                <span class="pf-course-card__category">Computer Science</span>
                <h3 class="pf-course-card__title">ASP.NET Core Architecture & Systems</h3>
                <p class="pf-body-cell">
                    Deep dive into MVC lifecycle, session management, middleware pipelines, and scalable enterprise patterns.
                </p>
                <div class="pf-course-card__meta">
                    <span>Educator: Prof. Vance</span> &middot; <span class="pf-status pf-status--live">Live</span>
                </div>
                <div class="pf-course-card__actions">
                    <a href="/Course/Details/1" class="pf-btn pf-btn--sm">View Path</a>
                </div>
            </div>

            <!-- Course Card 2 -->
            <div class="pf-course-card">
                <span class="pf-course-card__category">Database Engineering</span>
                <h3 class="pf-course-card__title">Entity Framework Core & Relational Design</h3>
                <p class="pf-body-cell">
                    Design robust schemas with fluent API configurations, restrict cascade constraints, and migrations.
                </p>
                <div class="pf-course-card__meta">
                    <span>Educator: Dr. Aris</span> &middot; <span class="pf-status pf-status--live">Live</span>
                </div>
                <div class="pf-course-card__actions">
                    <a href="/Course/Details/2" class="pf-btn pf-btn--sm">View Path</a>
                </div>
            </div>

            <!-- Course Card 3 -->
            <div class="pf-course-card">
                <span class="pf-course-card__category">Design Systems</span>
                <h3 class="pf-course-card__title">Editorial Typography & Poster Aesthetics</h3>
                <p class="pf-body-cell">
                    Translating bold print editorial standards into high-performance web systems with Tailwind CSS v4.
                </p>
                <div class="pf-course-card__meta">
                    <span>Educator: Elena Rostova</span> &middot; <span class="pf-status pf-status--draft">Draft</span>
                </div>
                <div class="pf-course-card__actions">
                    <a href="/Course/Details/3" class="pf-btn pf-btn--sm pf-btn--ghost">Preview</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Architectural Principles -->
    <section class="pf-section-light my-12 border-[3px] border-[var(--dark)]">
        <span class="pf-label mb-2">DESIGN MANIFESTO</span>
        <h2 class="pf-section-header mb-4">The Uncompromising Frame</h2>
        <p class="pf-body mb-6">
            PathForge abandons generic SaaS templates in favor of high-contrast editorial hierarchy:
        </p>
        <ul class="pf-bullets">
            <li>Strict four-color palette: Pure White, Deep Charcoal, Flame Red, and Editorial Cream.</li>
            <li>No rounded corners or soft ambient blur — geometry is unapologetically sharp, structured, and confident.</li>
            <li>Cantilevered red leftbar cards and fin-grid double borders establish unwavering reading rhythm.</li>
        </ul>
    </section>
</div>
