@model PathForge.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
    bool isStudent = Model.Role == "Student";
}

<div class="pf-page" style="padding-top:3rem; padding-bottom:3rem;">

  <div style="border-bottom:var(--border-outer); padding-bottom:1.5rem; margin-bottom:2rem;">
    <span class="pf-label">@Model.Role Dashboard</span>
    <h1 class="pf-section-header" style="margin-top:0.4rem;">Welcome back, @Model.UserName</h1>
  </div>

  @* Stat strip *@
  <div class="pf-stat-grid" style="margin-bottom:2.5rem;">
    <div class="pf-stat-cell">
      <span class="pf-stat-cell__number">@Model.StatA</span>
      <span class="pf-stat-cell__label">@Model.StatALabel</span>
    </div>
    <div class="pf-stat-cell">
      <span class="pf-stat-cell__number">@Model.StatB</span>
      <span class="pf-stat-cell__label">@Model.StatBLabel</span>
    </div>
    <div class="pf-stat-cell">
      <span class="pf-stat-cell__number">@Model.StatC</span>
      <span class="pf-stat-cell__label">@Model.StatCLabel</span>
    </div>
  </div>

  @if (isStudent)
  {
    <div style="display:grid; grid-template-columns:2fr 1fr; gap:2.5rem; align-items:start;">

      @* Continue learning *@
      <div>
        <h2 class="pf-card-title" style="margin-bottom:1.25rem;">Continue Learning</h2>

        @if (!Model.InProgressCourses.Any())
        {
          <div class="pf-card pf-card--outlined" style="padding:1.5rem;">
            <p class="pf-body">You haven't enrolled in any courses yet.</p>
            <a href="/Course" class="pf-btn pf-btn--sm" style="margin-top:0.75rem;">Browse Courses</a>
          </div>
        }
        else
        {
          <div style="display:flex; flex-direction:column; gap:1rem;">
            @foreach (var row in Model.InProgressCourses)
            {
              <div class="pf-card pf-card--outlined" style="padding:1.25rem 1.5rem;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:1rem;">
                  <div>
                    <span class="pf-label">@row.Course.Category</span>
                    <h3 class="pf-card-title" style="font-size:1.15rem; margin-top:0.2rem;">
                      @row.Course.Title
                    </h3>
                    <p class="pf-body-cell" style="opacity:0.6; margin-top:0.2rem;">
                      @row.CompletedModules of @row.TotalModules modules · By @row.Course.Educator.FullName
                    </p>
                  </div>
                  <span class="pf-cell-number">@row.Percent%</span>
                </div>
                <div class="pf-progress" style="margin-top:0.9rem;">
                  <div class="pf-progress__fill" style="width:@(row.Percent)%;"></div>
                </div>
                <div style="margin-top:0.9rem; display:flex; gap:0.5rem;">
                  <a asp-controller="Course" asp-action="Details" asp-route-id="@row.Course.Id"
                     class="pf-btn pf-btn--sm">Open Course</a>
                  <a asp-controller="Progress" asp-action="Index"
                     class="pf-btn pf-btn--ghost pf-btn--sm">Constellation</a>
                </div>
              </div>
            }
          </div>
        }
      </div>

      @* Upcoming assignments *@
      <div>
        <h2 class="pf-card-title" style="margin-bottom:1.25rem;">Due Soon</h2>
        @if (!Model.UpcomingAssignments.Any())
        {
          <div class="pf-card pf-card--outlined" style="padding:1.25rem;">
            <p class="pf-body-cell" style="opacity:0.7;">Nothing due. You're all caught up.</p>
          </div>
        }
        else
        {
          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            @foreach (var a in Model.UpcomingAssignments)
            {
              <div class="pf-card pf-card--outlined" style="padding:1rem 1.25rem;">
                <span class="pf-label">@a.Course.Title</span>
                <h3 class="pf-card-title" style="font-size:1rem; margin-top:0.2rem;">@a.Title</h3>
                <p class="pf-body-cell" style="color:var(--red); margin-top:0.3rem;">
                  Due @a.DueDate.ToString("dd MMM yyyy")
                </p>
                <a asp-controller="Assignment" asp-action="Submit" asp-route-id="@a.Id"
                   class="pf-btn pf-btn--ghost pf-btn--sm" style="margin-top:0.5rem;">Submit</a>
              </div>
            }
          </div>
        }

        @* Recent announcements *@
        <h2 class="pf-card-title" style="margin:2rem 0 1.25rem;">Announcements</h2>
        @if (!Model.RecentAnnouncements.Any())
        {
          <div class="pf-card pf-card--outlined" style="padding:1.25rem;">
            <p class="pf-body-cell" style="opacity:0.7;">No announcements from your courses.</p>
          </div>
        }
        else
        {
          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            @foreach (var an in Model.RecentAnnouncements)
            {
              <div class="pf-card pf-card--outlined" style="padding:1rem 1.25rem;">
                <span class="pf-label">
                  @(an.IsPinned ? "Pinned · " : "")@an.Course.Title · @an.CreatedAt.ToString("dd MMM")
                </span>
                <h3 class="pf-card-title" style="font-size:1rem; margin-top:0.2rem;">@an.Title</h3>
                <p class="pf-body-cell" style="margin-top:0.3rem; opacity:0.75;
                   overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
                  @an.Body
                </p>
                <a asp-controller="Announcement" asp-action="Index" asp-route-courseId="@an.CourseId"
                   class="pf-btn pf-btn--ghost pf-btn--sm" style="margin-top:0.5rem;">Read</a>
              </div>
            }
          </div>
        }
      </div>
    </div>
  }
  else
  {
    @* Educator / Admin *@
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;
                flex-wrap:wrap; gap:1rem;">
      <h2 class="pf-card-title">My Courses</h2>
      <div style="display:flex; gap:0.5rem;">
        <a asp-controller="Course" asp-action="Create" class="pf-btn pf-btn--sm">+ New Course</a>
        <a asp-controller="Course" asp-action="Manage" class="pf-btn pf-btn--ghost pf-btn--sm">Manage All</a>
      </div>
    </div>

    @if (Model.UngradedSubmissions > 0)
    {
      <div class="pf-alert" style="margin-bottom:1.5rem;">
        You have @Model.UngradedSubmissions submission(s) waiting to be graded.
      </div>
    }

    @if (!Model.MyCourses.Any())
    {
      <div class="pf-card pf-card--outlined" style="padding:1.5rem;">
        <p class="pf-body">No courses yet. Create your first one to get started.</p>
      </div>
    }
    else
    {
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:1.5rem;">
        @foreach (var c in Model.MyCourses)
        {
          int ungraded = c.Assignments.SelectMany(a => a.Submissions)
                          .Count(s => s.Status == "Submitted" || s.Status == "Late");
          <div class="pf-course-card">
            <div style="padding:1.25rem 1.5rem;">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="pf-course-card__category">@c.Category</span>
                <span class="pf-status pf-status--@c.Status.ToLower()">@c.Status</span>
              </div>
              <h3 class="pf-course-card__title" style="margin-top:0.35rem;">@c.Title</h3>
              <div class="pf-course-card__meta" style="margin-top:0.6rem;">
                @c.Enrolments.Count enrolled
                @if (ungraded > 0)
                {
                  <span class="pf-status pf-status--live" style="margin-left:0.5rem;">@ungraded to grade</span>
                }
              </div>
              <div class="pf-course-card__actions">
                <a asp-controller="Course" asp-action="EditModules" asp-route-id="@c.Id"
                   class="pf-btn pf-btn--sm">Edit</a>
                <a asp-controller="Course" asp-action="Details" asp-route-id="@c.Id"
                   class="pf-btn pf-btn--ghost pf-btn--sm">View</a>
              </div>
            </div>
          </div>
        }
      </div>
    }
  }

</div>
